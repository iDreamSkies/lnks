Options -Indexes
RewriteEngine On

# Protect storage and config
RewriteRule ^storage/ - [F]
RewriteRule ^(config\.php|config\.example\.php|schema\.sql|bootstrap\.php)$ - [F]

# Route short codes to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
