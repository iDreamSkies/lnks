Options -Indexes
RewriteEngine On

# Pass the Authorization header to PHP (needed for the API under CGI/FastCGI)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Protect storage, VCS data and internal files
RewriteRule ^(storage|lang|tests)/ - [F]
RewriteRule ^\.git(/|$) - [F]
RewriteRule ^(config\.php|config\.example\.php|schema\.sql|bootstrap\.php|layout\.php|i18n\.php|router\.php|README(\.ru)?\.md|LICENSE|\.gitignore)$ - [F]

# Route short codes to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
